# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=cakestudio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cakestudio
# The backend builds its database address from the POSTGRES_* values above (any characters are fine in the password).
# Only set DATABASE_URL if you use an external database; then URL-encode special characters (@ becomes %40).
DATABASE_URL=
JWT_SECRET=generate-with-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Public address of the site (used in emailed links) and allowed browser origin
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
WEB_PORT=8080
# Initial super admin (created by seed if no users exist)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
# DEV ONLY: log verification/reset links instead of emailing them (leave false in production)
DEV_LOG_EMAIL_LINKS=false
# Optional email (SMTP) and WhatsApp Cloud API credentials; enable each in Admin > Site settings > Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Image storage: "local" (Docker volume, default) or "s3" (AWS S3 / Cloudflare R2 / MinIO / Spaces)
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
